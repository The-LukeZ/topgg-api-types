{
  "name": "topgg-api-types",
  "author": {
    "name": "The-LukeZ",
    "email": "contact.lukez@proton.me",
    "url": "https://github.com/The-LukeZ"
  },
  "type": "module",
  "version": "0.1.1",
  "license": "MIT",
  "description": "Top.gg API types and validators for TypeScript",
  "repository": {
    "url": "https://github.com/The-LukeZ/topgg-api-types"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./v0": {
      "import": "./dist/v0.js",
      "require": "./dist/v0.cjs"
    },
    "./v0/validators": {
      "import": "./dist/v0/validators.js",
      "require": "./dist/v0/validators.cjs"
    },
    "./v1": {
      "import": "./dist/v1.js",
      "require": "./dist/v1.cjs"
    },
    "./v1/validators": {
      "import": "./dist/v1/validators.js",
      "require": "./dist/v1/validators.cjs"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "topgg",
    "types",
    "typescript",
    "api"
  ],
  "scripts": {
    "push-with-tags": "git push && git push --tags",
    "v:patch": "pnpm version patch -m \"Bump version to %s\"",
    "v:minor": "pnpm version minor -m \"Bump version to %s\"",
    "v:major": "pnpm version major -m \"Bump version to %s\"",
    "prepublishOnly": "pnpm run build",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "prettier --write .",
    "lint": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "packageManager": "pnpm@11.22.0"
}
