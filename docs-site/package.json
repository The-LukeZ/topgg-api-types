{
  "name": "docs-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "docs:api": "node ../tooling/typedoc/node_modules/typedoc/bin/typedoc --options ../typedoc.json --tsconfig ../tsconfig.json && node scripts/sync-api-docs.mjs",
    "predev": "pnpm run docs:api",
    "prebuild": "pnpm run docs:api"
  },
  "dependencies": {
    "svelte-docsmith": "^0.13.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.4",
    "@sveltejs/kit": "^2.16.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.0.0",
    "wrangler": "^4.0.0"
  }
}
