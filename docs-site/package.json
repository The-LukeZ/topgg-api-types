{
  "name": "docs-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "docs:api": "node ../tooling/typedoc/node_modules/typedoc/bin/typedoc --options ../typedoc.json --tsconfig ../tsconfig.json && node scripts/sync-api-docs.mjs",
    "predev": "pnpm run docs:api",
    "prebuild": "pnpm run docs:api",
    "cf-typegen": "wrangler types --include-main-module=false"
  },
  "dependencies": {
    "svelte-docsmith": "^0.29.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "6.0.3",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  }
}
